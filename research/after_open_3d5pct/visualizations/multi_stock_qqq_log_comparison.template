<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>22只高触及股与QQQ · 同图等百分比比较</title>
<style>
:root{--bg:#edf2f4;--paper:#fff;--tint:#f4f8f9;--ink:#17333f;--muted:#5f737c;--line:#cddade;--accent:#14727d;--focus:#245aa3;--qqq:#1f3038;--s100:#245aa3;--s90:#247680;--s80:#668a8b;--s70:#806a99;--s60:#a37d41;--s50:#9a6b71;--shadow:0 8px 30px #173b490d}
@media(prefers-color-scheme:dark){:root{--bg:#091c26;--paper:#102c39;--tint:#183746;--ink:#e8f2f4;--muted:#acc2ca;--line:#395764;--accent:#70cbd0;--focus:#9fc4ff;--qqq:#f1f6f7;--s100:#8bbcff;--s90:#7fced1;--s80:#acc6c5;--s70:#d3b4e7;--s60:#e6c486;--s50:#ddb0b5;--shadow:0 8px 30px #0003}}
:root[data-theme="light"]{--bg:#edf2f4;--paper:#fff;--tint:#f4f8f9;--ink:#17333f;--muted:#5f737c;--line:#cddade;--accent:#14727d;--focus:#245aa3;--qqq:#1f3038;--s100:#245aa3;--s90:#247680;--s80:#668a8b;--s70:#806a99;--s60:#a37d41;--s50:#9a6b71;--shadow:0 8px 30px #173b490d}
:root[data-theme="dark"]{--bg:#091c26;--paper:#102c39;--tint:#183746;--ink:#e8f2f4;--muted:#acc2ca;--line:#395764;--accent:#70cbd0;--focus:#9fc4ff;--qqq:#f1f6f7;--s100:#8bbcff;--s90:#7fced1;--s80:#acc6c5;--s70:#d3b4e7;--s60:#e6c486;--s50:#ddb0b5;--shadow:0 8px 30px #0003}
*{box-sizing:border-box}html{background:var(--bg);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei",Arial,sans-serif}body{margin:0}h1,h2,p{margin:0}button{font:inherit;color:inherit;cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid var(--accent);outline-offset:2px}.shell{max-width:1600px;margin:auto;padding:24px 28px 60px;display:grid;gap:17px}.mast{display:flex;justify-content:space-between;align-items:start;gap:20px}.eyebrow{font-size:11px;letter-spacing:.16em;font-weight:800;color:var(--accent)}h1{font-size:clamp(25px,3vw,36px);letter-spacing:-.035em;line-height:1.2;margin-top:7px;text-wrap:balance}.lead{font-size:14px;line-height:1.6;color:var(--muted);margin-top:9px;max-width:81ch}.theme{background:var(--paper);border:1px solid var(--line);padding:8px 11px;white-space:nowrap}.method{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.method div{background:var(--paper);border:1px solid var(--line);padding:12px 15px;min-width:0}.method small{display:block;color:var(--muted);font-size:11px;font-weight:700}.method strong{display:block;font-size:15px;margin-top:5px;line-height:1.4}.method span{display:block;color:var(--muted);font-size:11px;margin-top:5px;line-height:1.4}.callout{padding:11px 14px;border-left:4px solid var(--accent);background:var(--paper);font-size:13px;line-height:1.55;color:var(--muted)}.callout b{color:var(--ink)}.summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.metric{background:var(--paper);border:1px solid var(--line);padding:12px 15px}.metric small{display:block;color:var(--muted);font-size:11px}.metric strong{display:block;font:700 21px ui-monospace,SFMono-Regular,Menlo,monospace;margin-top:6px;font-variant-numeric:tabular-nums}.metric span{display:block;color:var(--muted);font-size:11px;margin-top:4px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:14px}.panel{background:var(--paper);border:1px solid var(--line);box-shadow:var(--shadow);min-width:0;padding:17px}.panelhead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}.panelhead h2{font-size:19px}.panelhead p{color:var(--muted);font-size:12px}.toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:12px 0}.axis{display:flex;border:1px solid var(--line);background:var(--tint)}.axis button{border:0;background:transparent;padding:7px 11px;font-size:12px}.axis button[aria-pressed="true"]{background:var(--accent);color:var(--paper);font-weight:700}.key{display:flex;gap:12px;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:11px}.key span{display:inline-flex;gap:5px;align-items:center}.swatch{width:18px;height:0;border-top:3px solid var(--qqq)}.swatch.stock{border-color:var(--s100)}.swatch.other{border-color:var(--muted);opacity:.5}.chartwrap{overflow-x:auto;border:1px solid var(--line);background:var(--tint)}svg.chart{display:block;width:100%;min-width:1000px;height:auto}.cursor{background:var(--tint);border:1px solid var(--line);padding:10px 12px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;font-size:12px;line-height:1.4;margin-top:10px}.cursor small{display:block;color:var(--muted)}.cursor b{display:block;margin-top:4px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-variant-numeric:tabular-nums}.note{font-size:12px;color:var(--muted);line-height:1.55;margin-top:9px}.side-head{display:grid;gap:5px}.side-head h2{font-size:19px}.side-head p{font-size:12px;color:var(--muted);line-height:1.5}.list{max-height:660px;overflow:auto;border-top:1px solid var(--line);margin-top:12px}.stock{width:100%;display:grid;grid-template-columns:8px 53px 71px 75px 1fr;align-items:center;gap:6px;border:0;border-bottom:1px solid var(--line);background:transparent;padding:8px 6px;text-align:left;font-size:11px;font-variant-numeric:tabular-nums}.stock:hover,.stock[aria-pressed="true"]{background:var(--tint)}.stock[aria-pressed="true"]{box-shadow:inset 3px 0 var(--accent)}.stock b{font-size:12px}.stock .bar{height:9px;align-self:center;background:var(--line);position:relative}.stock .bar i{display:block;height:100%;background:var(--accent)}.stock .rank{width:7px;height:18px;background:var(--rate-color)}.stock-head{display:grid;grid-template-columns:8px 53px 71px 75px 1fr;gap:6px;padding:7px 6px;color:var(--muted);font-size:10px;font-weight:800}.qqq-row{margin-top:11px;padding:10px;background:var(--tint);border:1px solid var(--line);font-size:12px;line-height:1.5}.qqq-row strong{font-size:15px}.footer{border-top:1px solid var(--line);padding-top:12px;color:var(--muted);font-size:12px;line-height:1.6;overflow-wrap:anywhere}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-variant-numeric:tabular-nums}
@media(max-width:1120px){.layout{grid-template-columns:1fr}.list{max-height:345px}.summary{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){.shell{padding:14px 11px 40px}.mast{display:grid}.theme{justify-self:start}.method{grid-template-columns:1fr}.summary{gap:7px}.metric{padding:10px}.metric strong{font-size:17px}.panel{padding:12px}.cursor{grid-template-columns:1fr 1fr}.stock{grid-template-columns:8px 45px 65px 70px 1fr}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<main class="shell">
<header class="mast"><div><p class="eyebrow">MARKET CONTEXT / COMPARABLE PRICE SCALE</p><h1>22 只高触及率股票，与 QQQ 画在同一把尺子上</h1><p class="lead">所有曲线以 2026 年 9 月 14 日 09:30 ET 的常规时段开盘价为 100，随后使用每根 5 分钟 K 线的收盘价。默认对数纵轴：每向上一格都乘以相同倍数；QQQ 用粗线标出。</p></div><button class="theme" id="theme" type="button">切换明暗</button></header>
<section class="method" aria-label="比较口径"><div><small>共同基点</small><strong>09-14 09:30 ET = 100</strong><span>每只股票及 QQQ 都用自己的当时开盘价归一化。</span></div><div><small>默认纵轴</small><strong>log(归一化价格)</strong><span>100 → 110 和 121 → 133.1 都是 +10%，高度相等。</span></div><div><small>数据窗口</small><strong>09-14 至 09-24</strong><span>九个完整常规交易日；隔夜不画价线，横轴折叠非交易时段。</span></div></section>
<div class="callout"><b>先看市场背景：</b>QQQ 在这段窗口从共同基点上涨约 5.37%。但这 22 只股票是按同一时期之后才知道的三日触及率筛出的；它们的强势曲线是事后描述，不能证明事前能挑中。</div>
<section class="summary" id="summary" aria-label="同期比较摘要"></section>
<div class="layout">
<section class="panel" aria-labelledby="chartTitle"><div class="panelhead"><h2 id="chartTitle">全部 23 条价格路径</h2><p>22 股票 + QQQ · 同一图、同一时间、同一基点</p></div><div class="toolbar"><div class="axis" role="group" aria-label="纵轴类型"><button type="button" data-axis="log" aria-pressed="true">等百分比 · log</button><button type="button" data-axis="linear" aria-pressed="false">累计收益 · 线性</button></div><div class="key"><span><i class="swatch"></i>QQQ</span><span><i class="swatch stock"></i>当前高亮股票</span><span><i class="swatch other"></i>其他 21 只</span></div></div><div class="chartwrap"><svg class="chart" id="chart" viewBox="0 0 1400 620" role="img" aria-label="22只股票与QQQ归一化价格同图比较"></svg></div><div class="cursor" id="cursor" aria-live="polite"></div><p class="note" id="axisNote"></p></section>
<aside class="panel" aria-labelledby="listTitle"><div class="side-head"><h2 id="listTitle">点击股票，高亮路径</h2><p>名单按历史三日 +5% 触及率排序；右侧涨幅是 09-14 开盘到 09-24 收盘的另一项指标。所有 23 条曲线始终留在同一张图上。</p></div><div class="stock-head"><span></span><span>股票</span><span>触及</span><span>本期</span><span>本期涨幅</span></div><div class="list" id="stockList"></div><div class="qqq-row" id="qqqInfo"></div></aside>
</div>
<footer class="footer" id="provenance"></footer>
</main>
<script id="payload" type="application/json">__PAYLOAD__</script>
<script>
(()=>{
'use strict';
const D=JSON.parse(document.getElementById('payload').textContent),$=id=>document.getElementById(id);
let axis='log',focus='ALAB',cursorIndex=D.times_et.length-1;
const W=1400,H=620,L=75,R=142,T=34,B=48,pw=W-L-R,ph=H-T-B,n=D.times_et.length;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const signed=x=>`${x>=0?'+':''}${Number(x).toFixed(2)}%`,norm=x=>Number(x).toFixed(2);
const color=s=>{let r=D.series[s].touch_rate_pct;return s==='QQQ'?'var(--qqq)':r>=99?'var(--s100)':r>=90?'var(--s90)':r>=80?'var(--s80)':r>=70?'var(--s70)':r>=60?'var(--s60)':'var(--s50)'};
const x=i=>L+i/(n-1)*pw;
function y(v){let low=axis==='log'?90:90,high=axis==='log'?145:140;return axis==='log'?T+(Math.log(high)-Math.log(v))/(Math.log(high)-Math.log(low))*ph:T+(high-v)/(high-low)*ph}
function tickValues(){return axis==='log'?[100/1.1,100,110,121,133.1]:[90,100,110,120,130,140]}
function renderChart(){
 let svg=$('chart'),a=[];
 a.push(`<title>22只股票与QQQ同图；共同基点100，${axis==='log'?'对数纵轴':'线性纵轴'}</title>`);
 for(let v of tickValues()){let yy=y(v),label=`${v.toFixed(1)} / ${signed(v-100)}`;a.push(`<line x1="${L}" x2="${W-R}" y1="${yy.toFixed(2)}" y2="${yy.toFixed(2)}" stroke="var(--line)" stroke-width="${v===100?1.5:.8}"/><text x="${L-7}" y="${(yy+4).toFixed(2)}" text-anchor="end" fill="var(--muted)" font-size="11">${esc(signed(v-100))}</text>`)}
 D.session_boundaries.forEach((i,k)=>{let xx=x(k===0?0:i),day=D.session_days_et[k];a.push(`<line x1="${xx.toFixed(2)}" x2="${xx.toFixed(2)}" y1="${T}" y2="${H-B}" stroke="var(--line)" stroke-width=".8" stroke-dasharray="3 4"/><text x="${(xx+4).toFixed(2)}" y="${H-16}" fill="var(--muted)" font-size="11">${esc(day.slice(5))}</text>`)});
 for(let s of D.order.filter(x=>x!=='QQQ'&&x!==focus)){
  let v=D.series[s].normalized_price,p=v.map((z,i)=>`${i?'L':'M'}${x(i).toFixed(1)},${y(z).toFixed(1)}`).join('');a.push(`<path d="${p}" fill="none" stroke="${color(s)}" stroke-width="${D.series[s].touch_rate_pct===100?1.9:1.45}" opacity="${D.series[s].touch_rate_pct===100?.56:.36}" stroke-linecap="round" stroke-linejoin="round"><title>${esc(s)} · 历史触及 ${D.series[s].touches}/36 · 期末 ${signed(D.series[s].end_return_pct)}</title></path>`)
 }
 for(let s of ['QQQ',focus]){
  let v=D.series[s].normalized_price,p=v.map((z,i)=>`${i?'L':'M'}${x(i).toFixed(1)},${y(z).toFixed(1)}`).join('');a.push(`<path d="${p}" fill="none" stroke="${color(s)}" stroke-width="${s==='QQQ'?3.2:3.4}" ${s==='QQQ'?'stroke-dasharray="7 3"':''} opacity="1" stroke-linecap="round" stroke-linejoin="round"><title>${esc(s)} · 期末 ${signed(D.series[s].end_return_pct)}</title></path>`);
 }
 const fl=D.series[focus].normalized_price.at(-1),ql=D.series.QQQ.normalized_price.at(-1),fy=y(fl),qy=y(ql),tooClose=Math.abs(fy-qy)<20;
 a.push(`<circle cx="${x(n-1).toFixed(2)}" cy="${fy.toFixed(2)}" r="5" fill="${color(focus)}"/><text x="${(W-R+9).toFixed(2)}" y="${(fy+(tooClose?-9:4)).toFixed(2)}" fill="${color(focus)}" font-size="13" font-weight="700">${esc(focus)} ${esc(signed(fl-100))}</text>`);
 a.push(`<circle cx="${x(n-1).toFixed(2)}" cy="${qy.toFixed(2)}" r="5" fill="var(--qqq)"/><text x="${(W-R+9).toFixed(2)}" y="${(qy+(tooClose?12:4)).toFixed(2)}" fill="var(--qqq)" font-size="13" font-weight="700">QQQ ${esc(signed(ql-100))}</text>`);
 a.push(`<line id="crosshair" x1="0" x2="0" y1="${T}" y2="${H-B}" stroke="var(--accent)" stroke-width="1" stroke-dasharray="3 4" visibility="hidden"/><circle id="focusDot" r="5" fill="${color(focus)}" visibility="hidden"/><circle id="qqqDot" r="5" fill="var(--qqq)" visibility="hidden"/>`);
 svg.innerHTML=a.join('');$('axisNote').textContent=axis==='log'?'对数轴：相邻主要水平网格线为 ×1.10，代表相同的 10% 相对涨幅；因此刻度的累计百分点并非等间隔。':'线性轴：每相邻主要水平网格线相差 10 个累计收益百分点。两种轴使用完全相同的数据。';updateCursor(false)
}
function updateCursor(show){let i=cursorIndex,f=D.series[focus].normalized_price[i],q=D.series.QQQ.normalized_price[i],xx=x(i);$('cursor').innerHTML=`<div><small>鼠标位置 · ET</small><b>${esc(D.times_et[i])}</b></div><div><small>${esc(focus)} 累计价格变化</small><b>${signed(f-100)}</b></div><div><small>QQQ 累计价格变化</small><b>${signed(q-100)}</b></div><div><small>${esc(focus)} − QQQ</small><b>${signed(f-q)}</b></div>`;let c=$('crosshair'),fd=$('focusDot'),qd=$('qqqDot');if(!c)return;for(let el of [c,fd,qd])el.setAttribute('visibility',show?'visible':'hidden');if(show){c.setAttribute('x1',xx);c.setAttribute('x2',xx);fd.setAttribute('cx',xx);fd.setAttribute('cy',y(f));qd.setAttribute('cx',xx);qd.setAttribute('cy',y(q))}}
function renderList(){let qret=D.series.QQQ.end_return_pct;$('stockList').innerHTML=D.order.filter(s=>s!=='QQQ').map(s=>{let o=D.series[s];return `<button type="button" class="stock" data-symbol="${s}" aria-pressed="${s===focus}" style="--rate-color:${color(s)}"><i class="rank"></i><b>${s}</b><span>${o.touches}/36</span><span>${signed(o.end_return_pct)}</span><span class="bar"><i style="width:${Math.max(3,Math.min(100,o.end_return_pct/35*100))}%"></i></span></button>`}).join('');$('qqqInfo').innerHTML=`<strong>QQQ ${signed(qret)}</strong><br>同一延迟入场 / 234 根常规 K 线对照：${D.qqq_touch_control.touches}/${D.qqq_touch_control.decisions} 个时点触及 +5%。QQQ 是市场对照，不属于上述 22 只候选股。`}
function renderStats(){let f=D.series[focus],q=D.series.QQQ;let items=[['QQQ 期末价格变化',signed(q.end_return_pct),'共同基点至 09-24 收盘'],['22只跑赢 QQQ',`${D.comparison.stocks_outperforming_qqq_at_sep24_close} / ${D.comparison.stock_count}`,'按期末价格变化；名单事后筛选'],[`${focus} 期末价格变化`,signed(f.end_return_pct),'点击右侧其他股票切换'],[`${focus} − QQQ`,signed(f.end_return_pct-q.end_return_pct),'同一基点、同一收盘时刻']];$('summary').innerHTML=items.map(([a,b,c])=>`<div class="metric"><small>${esc(a)}</small><strong>${esc(b)}</strong><span>${esc(c)}</span></div>`).join('')}
function render(){renderStats();renderList();renderChart();document.querySelectorAll('[data-axis]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.axis===axis))}
$('stockList').addEventListener('click',ev=>{let b=ev.target.closest('[data-symbol]');if(!b)return;focus=b.dataset.symbol;render()});
document.querySelector('.axis').addEventListener('click',ev=>{let b=ev.target.closest('[data-axis]');if(!b)return;axis=b.dataset.axis;render()});
$('chart').addEventListener('mousemove',ev=>{let r=$('chart').getBoundingClientRect(),vx=(ev.clientX-r.left)*W/r.width;cursorIndex=Math.max(0,Math.min(n-1,Math.round((vx-L)/pw*(n-1))));updateCursor(true)});
$('chart').addEventListener('mouseleave',()=>updateCursor(false));
$('theme').addEventListener('click',()=>{let root=document.documentElement;root.dataset.theme=root.dataset.theme==='dark'?'light':'dark';try{localStorage.setItem('compareTheme',root.dataset.theme)}catch{}});
try{let saved=localStorage.getItem('compareTheme');if(saved==='light'||saved==='dark')document.documentElement.dataset.theme=saved}catch{}
$('provenance').innerHTML=`<b>口径：</b>价格基于富途 OpenD 的未复权 5 分钟常规时段 OHLC，图中只用 Close 画走势，统一以 09-14 第一根常规 K 线 Open 定基点；不含分红回投。QQQ、META、LRCX、STX 在窗口内有除息日。股票名单来自该窗口已成熟的 36 次三日 +5% 历史标签，是事后筛选；价格曲线不能用来证明事前胜率或可执行止盈。<br><span class="mono">数据生成 ${esc(D.generated_at_utc)} · 22 股票 × 702 根 + QQQ × 702 根，来源哈希随图内嵌。09-24 QQQ 尾盘由 OpenD 补入独立快照，未改原行情归档。</span>`;
render();
})();
</script>
</body>
</html>
